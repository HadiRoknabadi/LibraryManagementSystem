@model Application.DTOs.Borrowing.BorrowDetailsDTO
@using Application.Extensions
@{
    ViewData["Title"] = "جزئیات امانت";
}

<div class="col-lg-8 col-md-10 col-sm-12 col-xs-12 col-centered">
    <div class="panel panel-info">
        <div class="panel-heading">
            <h3 class="panel-title text-center">جزئیات</h3>
        </div>
        <div class="panel-body">
            <table class="table table-striped table-bordered">
                <tbody>
                    <tr>
                        <th class="col-sm-4">امانت‌ گیرنده</th>
                        <td>@Model.UserFullName</td>
                    </tr>
                    <tr>
                        <th>کارمند ثبت‌کننده</th>
                        <td>@Model.LibrarianFullName</td>
                    </tr>
                    <tr>
                        <th>نام کتاب</th>
                        <td>@Model.BookName</td>
                    </tr>
                    <tr>
                        <th>وضعیت</th>
                        <td>@Model.Status.GetEnumName()</td>
                    </tr>
                    <tr>
                        <th>تاریخ ثبت</th>
                        <td>@Model.BorrowDate</td>
                    </tr>
                    <tr>
                        <th>تاریخ سررسید</th>
                        <td>@Model.DueDate</td>
                    </tr>
                    <tr>
                        <th>تاریخ بازگشت</th>
                        <td>@Model.ReturnDate</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .col-centered {
        float: none;
        margin: 0 auto;
    }

    .panel-info {
        border-color: #bce8f1;
    }

        .panel-info > .panel-heading {
            background-color: #5bc0de;
            color: #fff;
        }
</style>
