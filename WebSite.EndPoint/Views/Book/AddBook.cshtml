@model Application.DTOs.Book.AddBookDTO
@using Application.DTOs.BookCategory
@using Application.DTOs.Publisher
@using Application.DTOs.Author

@{
    ViewData["Title"] = "افزودن کتاب";

    var categories = ViewData["Categories"] as List<BookCategoryListItemDTO>;
    var publishers = ViewData["Publishers"] as List<PublisherListItemDTO>;
    var authors = ViewData["Authors"] as List<AuthorListItemDTO>;
}

<div class="col-lg-12 col-sm-12 col-xs-12">
    <div class="widget">
        <div class="widget-header bordered-bottom bordered-blue">
            <span class="widget-caption">@ViewData["Title"]</span>
        </div>
        <div class="widget-body">
            <div>
                <form id="addBookFrm" asp-controller="Book" asp-action="AddBook"
                      enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>نام کتاب</label>
                                <input asp-for="Title" class="form-control">
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>ISBN</label>
                                <input asp-for="ISBN" class="form-control">
                                <span asp-validation-for="ISBN" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>دسته بندی</label>
                                <select asp-for="CategoryId" asp-items="@(new SelectList(categories, "Id", "Title"))"
                                        class="form-control">
                                    <option value="0">لطفا یک گزینه را انتخاب کنید</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>ناشر</label>
                                <select asp-for="PublisherId" asp-items="@(new SelectList(publishers, "Id", "Name"))"
                                        class="form-control">
                                    <option value="0">لطفا یک گزینه را انتخاب کنید</option>
                                </select>
                                <span asp-validation-for="PublisherId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label>نویسندگان</label>
                                <select multiple asp-for="AuthorIds" asp-items="@(new SelectList(authors, "Id", "FullName"))"
                                        class="form-control">
                                    <option value="0">لطفا یک گزینه را انتخاب کنید</option>
                                </select>
                                <span asp-validation-for="AuthorIds" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <a class="btn btn-danger" data-toggle="modal" data-target="#addAuthorModal">ایجاد نویسنده جدید</a>
                        </div>
                    </div>
                    <button type="button" id="addBookBtn" class="btn btn-success">ثبت اطلاعات</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- start Add Author Modal -->

<div class="modal fade" id="addAuthorModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">افزودن نویسنده</h5>
                <button type="button" class="close margin-top-minus-21" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group">

                    <form asp-controller="Author" asp-action="AddAuthor" method="post" asp-antiforgery="true" data-method="post" data-ajax="true" data-ajax-success="OnSuccessAddOrEditItem">



                        <partial name="~/Views/Author/_AddAuthor.cshtml" model="@(new AddAuthorDTO { })" />
                        <div class="custome-modal-footer">
                            <button type="submit" class="btn btn-success pull-right">ثبت</button>
                            <button type="button" class="btn btn-danger pull-right" data-dismiss="modal">بستن</button>
                        </div>
                    </form>

                </div>

            </div>

        </div>
    </div>
</div>
<!-- end Add Author Modal -->

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $("#addBookBtn").on('click', function () {


              var categoryId = $("#CategoryId").val();
              var publisherId = $("#PublisherId").val();

              if (categoryId == 0) {
                  ShowToastMessageNotification('خطا', 'لطفا دسته بندی را برای کتاب انتخاب کنید', 'warning');
                  return false;
              }

              if (publisherId == 0) {
                  ShowToastMessageNotification('خطا', 'لطفا ناشر را برای کتاب انتخاب کنید', 'warning');
                  return false;
              }

              $('#addBookFrm').submit();
          });
    </script>

}
